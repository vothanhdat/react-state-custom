{
  "name": "react-state-custom",
  "version": "1.6.0",
  "description": "Write a React hook once, use it anywhere: one running instance per params, shared by every caller, composed with hooks.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs"
    },
    "./dev-tool": {
      "types": "./dist/dev-tool/index.d.ts",
      "import": "./dist/dev-tool.es.js",
      "require": "./dist/dev-tool.cjs"
    },
    "./dev-tool/obj-view": {
      "types": "./dist/dev-tool/obj-view.d.ts",
      "import": "./dist/dev-tool/obj-view.es.js",
      "require": "./dist/dev-tool/obj-view.cjs"
    },
    "./style.css": "./dist/react-state-custom.css",
    "./dist/react-state-custom.css": "./dist/react-state-custom.css",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "dev-tool": [
        "./dist/dev-tool/index.d.ts"
      ],
      "dev-tool/obj-view": [
        "./dist/dev-tool/obj-view.d.ts"
      ]
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bugs": {
    "url": "https://github.com/vothanhdat/react-state-custom/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vothanhdat/react-state-custom.git"
  },
  "scripts": {
    "build": "vite build",
    "build:demo": "vite build --config vite.config.dev.ts",
    "dev": "vite",
    "dev:playground": "vite --config vite.config.dev.ts",
    "demo:tasks": "vite --config demos/task-manager/vite.config.mjs",
    "test": "vitest run --config vitest.config.test.ts",
    "test:watch": "vitest --config vitest.config.test.ts",
    "test:ui": "vitest --ui --config vitest.config.test.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.test.ts",
    "test:run": "vitest run --config vitest.config.test.ts",
    "preview": "vite preview --config vite.config.dev.ts",
    "prepublishOnly": "yarn build",
    "bench": "vitest bench --run --config vitest.config.bench.ts",
    "bench:browser": "node bench/browser/run.mjs",
    "test:compiler": "vitest run --config vitest.config.compiler.ts",
    "test:dist": "TEST_TARGET=dist vitest run --config vitest.config.compiler.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.types.json && tsc -p tsconfig.bench.json && tsc -p demos/task-manager",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "react",
    "react-hooks",
    "hooks",
    "state-management",
    "global-state",
    "store",
    "derived-state",
    "suspense",
    "typescript"
  ],
  "author": "Dat Vo",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-obj-view": ">=1.1.0"
  },
  "peerDependenciesMeta": {
    "react-obj-view": {
      "optional": true
    }
  },
  "devDependencies": {
    "@stackblitz/sdk": "^1.11.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^27",
    "@types/react": "^19.2.2",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.0.3",
    "@vitest/ui": "^4.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "jotai": "^3.0.1",
    "jsdom": "^27.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-error-boundary": "^6.0.0",
    "react-obj-view": "^1.1.10",
    "typescript": "^5.9.3",
    "vite": "7",
    "vite-bundle-analyzer": "^1.1.0",
    "vite-plugin-dts": "^4.5.4",
    "vitepress": "^1.6.4",
    "vitest": "^4.0.3",
    "zustand": "^5.0.15"
  },
  "packageManager": "yarn@4.6.0+sha512.5383cc12567a95f1d668fbe762dfe0075c595b4bfff433be478dbbe24e05251a8e8c3eb992a986667c1d53b6c3a9c85b8398c35a960587fbd9fa3a0915406728",
  "engines": {
    "node": ">=20.0.0"
  }
}
